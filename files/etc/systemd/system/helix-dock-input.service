[Unit]
Description=Recover ThinkPad Helix keyboard and pointers after base attachment

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/local/sbin/helix-dock-input-reset --controller
ExecStopPost=/usr/local/sbin/helix-dock-input-reset --restore-controller
TimeoutStartSec=25
TimeoutStopSec=20
