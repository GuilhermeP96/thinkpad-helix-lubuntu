#!/usr/bin/python3
"""Controls for ThinkPad Helix under LXQt/X11."""
import os
import re
import subprocess
import sys
from pathlib import Path

CONFIG = Path.home() / '.config/helix'
CONFIG.mkdir(exist_ok=True)
LOCK = CONFIG / 'rotation-locked'
MATRICES = {
    'normal': '1 0 0 0 1 0 0 0 1',
    'left': '0 -1 1 1 0 0 0 0 1',
    'inverted': '-1 0 1 0 -1 1 0 0 1',
    'right': '0 1 0 -1 0 1 0 0 1',
}

def run(*args):
    return subprocess.check_output(args, text=True, timeout=8).strip()

def notify(message):
    subprocess.run(['notify-send', 'ThinkPad Helix', message], timeout=5)

def display():
    query = run('xrandr', '--query')
    active = [line for line in query.splitlines()
              if re.search(r' connected .*\d+x\d+\+\d+\+\d+', line)]
    if len(active) != 1 or not active[0].startswith('eDP-1 '):
        return None
    mode = re.search(r'\d+x\d+\+\d+\+\d+(?: (normal|left|right|inverted))? ', active[0])
    return mode.group(1) or 'normal'

def rotate(orientation):
    if display() is None:
        return False
    run('xrandr', '--output', 'eDP-1', '--rotate', orientation)
    for line in run('xinput', '--list', '--short').splitlines():
        if 'Atmel Atmel maXTouch' in line or 'Wacom ISDv4 EC Pen' in line:
            device = re.search(r'id=(\d+)', line).group(1)
            run('xinput', 'set-prop', device, 'Coordinate Transformation Matrix',
                *MATRICES[orientation].split())
    return True

def daemon():
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    proxy = Gio.DBusProxy.new_sync(bus, Gio.DBusProxyFlags.NONE, None,
        'net.hadess.SensorProxy', '/net/hadess/SensorProxy',
        'net.hadess.SensorProxy', None)
    proxy.call_sync('ClaimAccelerometer', None, Gio.DBusCallFlags.NONE, 5000, None)
    state = {'tablet': False, 'orientation': None}
    def tick():
        try:
            tablet = Path('/sys/devices/platform/thinkpad_acpi/hotkey_tablet_mode').read_text().strip() == '1'
            if not LOCK.exists() and (tablet or state['tablet']) and display() is not None:
                if tablet:
                    value = proxy.get_cached_property('AccelerometerOrientation')
                    orientation = {'normal':'normal', 'bottom-up':'inverted',
                        'left-up':'left', 'right-up':'right'}.get(value.unpack() if value else '')
                    if orientation and (orientation != state['orientation'] or not state['tablet']):
                        rotate(orientation)
                        state['orientation'] = orientation
                elif state['tablet']:
                    rotate('normal')
                    state['orientation'] = None
            else:
                state['orientation'] = None
            state['tablet'] = tablet
        except (OSError, subprocess.SubprocessError) as error:
            print(error, file=sys.stderr, flush=True)
        return True
    GLib.timeout_add_seconds(2, tick)
    try:
        GLib.MainLoop().run()
    finally:
        proxy.call_sync('ReleaseAccelerometer', None, Gio.DBusCallFlags.NONE, 5000, None)

def main():
    action = sys.argv[1] if len(sys.argv) > 1 else 'rotate'
    if action == 'daemon':
        daemon()
    elif action in ('rotate', 'normal'):
        current = display()
        if current is None:
            notify('Rotação pausada enquanto houver monitor externo ativo.')
            return
        LOCK.touch()
        order = list(MATRICES)
        rotate('normal' if action == 'normal' else order[(order.index(current)+1)%4])
    elif action == 'auto':
        if LOCK.exists():
            LOCK.unlink()
            notify('Rotação automática ativada no modo tablet.')
        else:
            LOCK.touch()
            notify('Rotação automática bloqueada.')
    elif action == 'keyboard':
        from gi.repository import Gio, GLib
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        try:
            bus.call_sync('org.onboard.Onboard', '/org/onboard/Onboard/Keyboard',
                'org.onboard.Onboard.Keyboard', 'ToggleVisible', None, None,
                Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            subprocess.Popen(['onboard'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif action == 'touchpad':
        devices = run('xinput', '--list', '--name-only').splitlines()
        name = next(n for n in ('Synaptics TM2219-002', 'SynPS/2 Synaptics TouchPad') if n in devices)
        props = run('xinput', 'list-props', name)
        enabled = re.search(r'Device Enabled \(\d+\):\s*(\d)', props).group(1)
        run('xinput', 'set-prop', name, 'Device Enabled', '0' if enabled == '1' else '1')
        notify('Touchpad ' + ('desativado' if enabled == '1' else 'ativado'))
    elif action == 'recover':
        result = subprocess.run(['pkexec', '/usr/local/sbin/helix-pointer-reset'])
        if result.returncode == 0:
            notify('Touchpad e TrackPoint reinicializados. Afaste a caneta da tela.')
    elif action == 'wifi':
        run('nmcli', 'radio', 'wifi', 'off' if run('nmcli', 'radio', 'wifi') == 'enabled' else 'on')
    else:
        raise SystemExit('Uso: helix-controls rotate|normal|auto|keyboard|touchpad|recover|wifi|daemon')

if __name__ == '__main__':
    main()
