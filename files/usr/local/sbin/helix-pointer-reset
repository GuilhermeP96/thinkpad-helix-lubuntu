#!/usr/bin/python3
"""Reinitialize only mouse devices on this ThinkPad Helix."""
import os
import subprocess
from pathlib import Path

if os.geteuid() != 0:
    raise SystemExit('Execute com pkexec ou sudo.')
if Path('/sys/class/dmi/id/product_version').read_text().strip() != 'ThinkPad Helix':
    raise SystemExit('Este comando é específico para ThinkPad Helix.')
subprocess.run(['/usr/sbin/modprobe', '-r', 'psmouse'], check=True)
subprocess.run(['/usr/sbin/modprobe', 'psmouse', 'synaptics_intertouch=0'], check=True)
# An AUX port previously using SMBus may need an explicit reprobe.
ports = Path('/sys/devices/platform/i8042').glob('serio*')
for port in ports:
    if ((port / 'description').read_text().strip() == 'i8042 AUX port'
            and not (port / 'driver').exists()):
        (port / 'drvctl').write_text('rescan')
